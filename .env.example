DEBUG=True
SECRET_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_BOOKS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIELD_ENCRYPTION_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=

# 本番環境では以下を設定する
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=

# 本番環境では全て True に変更する
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# 本番環境では 31536000 (1年) を推奨
SECURE_HSTS_SECONDS=0

# React(Vite) からのアクセスを許可するオリジン（カンマ区切り）。
# DEBUG=True のときは未指定でも http://localhost:5173 / http://127.0.0.1:5173 を自動許可する。
# 本番で別オリジン配信する場合のみ設定する（同一オリジン配信なら不要）。
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
